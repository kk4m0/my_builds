@startuml PRBS-Class-Diagram
left to right direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

class StaffAccount <<entity>> {
  +UUID staffId
  +String username
  +String passwordHash
  +String role
  +authenticate(password) Boolean
}

class Owner <<entity>> {
  +UUID ownerId
  +String fullName
  +String phone
  +String email
  +String address
}

class Pet <<entity>> {
  +UUID petId
  +String name
  +String breed
  +Integer ageYears
  +hasActiveAlert() Boolean
}

class MedicalAlert <<entity>> {
  +UUID alertId
  +String medicalConditions
  +String allergies
  +String dietaryRestrictions
  +Boolean active
  +DateTime updatedAt
}

class EmergencyVetContact <<entity>> {
  +UUID contactId
  +String contactName
  +String practiceName
  +String phone
  +String address
}

class DailyStatus <<entity>> {
  +UUID statusId
  +Date statusDate
  +String notes
  +String careStatus
}

class Booking <<entity>> {
  +UUID bookingId
  +Date startDate
  +Date endDate
  +String status
  +String ownerContactName
  +String ownerContactPhone
  +validateDates() Boolean
  +cancel()
}

class DaycareFacility <<entity>> {
  +UUID facilityId
  +String name
  +Integer maximumCapacity
}

class OccupancyReport <<entity>> {
  +UUID reportId
  +Date reportDate
  +Integer occupiedPlaces
  +Integer availablePlaces
  +generate()
}

class ServiceRequest <<entity>> {
  +UUID requestId
  +String subject
  +String description
  +String priority
  +String status
  +close()
}

class Equipment <<entity>> {
  +UUID equipmentId
  +String name
  +String category
  +String status
  +updateStatus(status)
}

class Technician <<entity>> {
  +UUID technicianId
  +String fullName
  +String phone
  +String speciality
}

class TechnicianSchedule <<entity>> {
  +UUID scheduleId
  +Date shiftDate
  +Time startTime
  +Time endTime
  +String status
  +isAvailable() Boolean
}

Owner "1" --> "0..*" Pet : owns
Pet "1" *-- "0..*" MedicalAlert : has
Pet "1" *-- "0..1" EmergencyVetContact : has
Pet "1" *-- "0..*" DailyStatus : records

Booking "0..*" --> "1" Pet : for
Booking "0..*" --> "1" Owner : contact owner
Booking "0..*" --> "1" DaycareFacility : booked at
DaycareFacility "1" --> "0..*" OccupancyReport : produces
OccupancyReport ..> Booking : counts

Owner "1" --> "0..*" ServiceRequest : submits
ServiceRequest "0..*" --> "0..1" Technician : assigned to
ServiceRequest "0..*" --> "0..*" Equipment : uses
Technician "1" --> "0..*" TechnicianSchedule : has

StaffAccount ..> Pet : maintains records
StaffAccount ..> Booking : manages
StaffAccount ..> ServiceRequest : manages
StaffAccount ..> OccupancyReport : generates

note "Every booking references one existing Pet and must pass the capacity check before it is saved." as BookingRule
BookingRule .. Booking
@enduml
