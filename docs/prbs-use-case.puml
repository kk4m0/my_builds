@startuml PRBS-Use-Case
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #E7F2FB
  BorderColor #2B6F9F
  ArrowColor #486581
}

actor "Authorised staff member" as Staff
actor "Pet owner / client" as PetOwner
actor "System administrator" as Admin
actor "Manager" as Manager

Admin --|> Staff
Manager --|> Staff

rectangle "Pet Records & Booking System (PRBS)" {
  usecase "Authenticate user (FR1)" as UC_Authenticate
  usecase "Manage staff accounts (FR2)" as UC_StaffManagement
  usecase "Manage pet records\nand alerts" as UC_PetManagement
  usecase "Manage bookings\nand capacity" as UC_BookingManagement
  usecase "Manage client\nservice requests" as UC_RequestManagement
  usecase "Track equipment" as UC_EquipmentManagement
  usecase "Manage technician\nschedules" as UC_ScheduleManagement
  usecase "Generate occupancy\nreport (FR12)" as UC_OccupancyManagement

  package "Authentication details" {
    usecase "Authenticate credentials" as UC_Credentials
  }

  package "Pet record details" {
    usecase "Register pet profile (FR3)" as UC_RegisterPet
    usecase "Maintain pet profile (FR4)" as UC_MaintainPet
    usecase "Capture vet contact /\nemergency vet information (FR5)" as UC_VetContact
    usecase "Maintain medical and\ndietary alerts" as UC_MaintainAlerts
    usecase "View medical alerts (FR10)" as UC_ViewAlerts
    usecase "Display medical detail" as UC_MedicalDetail
    usecase "Update daily status (FR11)" as UC_DailyStatus
  }

  package "Booking details" {
    usecase "Create booking (FR6)" as UC_CreateBooking
    usecase "Maintain booking (FR7)" as UC_MaintainBooking
    usecase "Link booking to\npet profile (FR8)" as UC_LinkPet
    usecase "Check facility\ncapacity (FR9)" as UC_Capacity
    usecase "Display occupancy\nwarning" as UC_OccupancyWarning
  }
}

Staff --> UC_Authenticate
Staff --> UC_PetManagement
Staff --> UC_BookingManagement
Staff --> UC_RequestManagement
Staff --> UC_EquipmentManagement
Staff --> UC_ScheduleManagement
Staff --> UC_OccupancyManagement

PetOwner --> UC_Authenticate
PetOwner --> UC_PetManagement
PetOwner --> UC_BookingManagement
PetOwner --> UC_RequestManagement

Admin --> UC_StaffManagement

UC_Authenticate .> UC_Credentials : <<include>>
UC_PetManagement .> UC_RegisterPet : <<include>>
UC_PetManagement .> UC_MaintainPet : <<include>>
UC_PetManagement .> UC_VetContact : <<include>>
UC_PetManagement .> UC_MaintainAlerts : <<include>>
UC_PetManagement .> UC_ViewAlerts : <<include>>
UC_PetManagement .> UC_DailyStatus : <<include>>
UC_ViewAlerts .> UC_MedicalDetail : <<include>>
UC_BookingManagement .> UC_CreateBooking : <<include>>
UC_BookingManagement .> UC_MaintainBooking : <<include>>
UC_CreateBooking .> UC_LinkPet : <<include>>
UC_CreateBooking .> UC_Capacity : <<include>>
UC_MaintainBooking .> UC_Capacity : <<include>>
UC_Capacity .> UC_OccupancyWarning : <<extend: capacity exceeded>>

note right of UC_Authenticate
All protected functions require
successful authentication.
end note

note bottom of UC_BookingManagement
A booking is saved only when the pet
exists and facility capacity is available.
end note
@enduml
