@startuml PRBS-Use-Case
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #E7F2FB
  BorderColor #2B6F9F
  ArrowColor #486581
}

actor "Authorised staff member" as Staff

rectangle "Pet Records & Booking System (PRBS)" {
  usecase "Authenticate staff" as UC_Login
  usecase "Manage pet profiles\n(create / view / update / delete)" as UC_PetProfiles
  usecase "Manage medical and dietary alerts\n(record / update / display flag)" as UC_Alerts
  usecase "Manage emergency veterinary\ninformation" as UC_VetInfo
  usecase "Manage daycare bookings\n(create / view / edit / cancel)" as UC_Bookings
  usecase "Validate pet is linked\nto an existing profile" as UC_LinkPet
  usecase "Check daycare capacity" as UC_Capacity
  usecase "Manage client service requests\n(create / update / assign / close)" as UC_Requests
  usecase "Track equipment\n(register / update / allocate / return)" as UC_Equipment
  usecase "Manage technician schedules\n(create / view / update / check availability)" as UC_Schedules
}

Staff --> UC_Login
Staff --> UC_PetProfiles
Staff --> UC_Alerts
Staff --> UC_VetInfo
Staff --> UC_Bookings
Staff --> UC_Requests
Staff --> UC_Equipment
Staff --> UC_Schedules

UC_Bookings .> UC_LinkPet : <<include>>
UC_Bookings .> UC_Capacity : <<include>>

note right of UC_Login
Successful authentication is required
before protected functions are used.
end note

note bottom of UC_Bookings
A booking is saved only when the pet
exists and capacity is available.
end note
@enduml
